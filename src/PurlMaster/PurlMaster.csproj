<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>purl-master</AssemblyName>
    <RootNamespace>PurlMaster</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <EmbeddedResource Include="../../docs/schemas/bom-1.2.schema.json;../../docs/schemas/bom-1.3.schema.json;../../docs/schemas/bom-1.4.schema.json;../../docs/schemas/bom-1.5.schema.json;../../docs/schemas/bom-1.6.schema.json;../../docs/schemas/spdx.schema.json;../../docs/schemas/jsf-0.82.schema.json" Link="Schemas/%(Filename)%(Extension)" />
    <None Include="@(EmbeddedResource)" Link="Schemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
